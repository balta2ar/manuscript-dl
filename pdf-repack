_VERSION_NUM = re.compile(r'(\d+(?:\.\d+)+)')


def _version_of(program: str, flags: list[str]) -> str | None:
    try:
        r = run([program] + flags, capture_output=True, text=True,
                           timeout=30, env={**environ, '_JAVA_OPTIONS': ''})
    except (OSError, SubprocessError):
        return None
    text = (r.stdout or '') + (r.stderr or '')
    for line in text.splitlines():
        m = _VERSION_NUM.search(line)
        if m:
            return m.group(1)
    return text.strip().splitlines()[0][:40] if text.strip() else '?'


def _ocrmypdf_python() -> str | None:
    """Find the interpreter ocrmypdf runs under, from its shebang.

    ocrmypdf is an external program with its own environment. Its Python
    dependencies must be probed there, not in this script's uv environment,
    where they are neither present nor relevant.
    """
    path = which('ocrmypdf')
    if not path:
        return None
    try:
        with open(path, 'rb') as fh:
            first = fh.readline(400).decode('utf-8', 'replace')
    except OSError:
        return None
    if first.startswith('#!'):
        candidate = first[2:].strip().split()
        if candidate and Path(candidate[0]).exists():
            return candidate[0]
    return None


def _has_noto_fonts() -> bool | None:
    """Noto covers scripts ocrmypdf's bundled Latin font does not."""
    if not which('fc-list'):
        return None
    try:
        r = run(['fc-list', ':', 'family'], capture_output=True, text=True, timeout=30)
    except (OSError, SubprocessError):
        return None
    return 'noto' in (r.stdout or '').lower()


def doctor(lang: str) -> int:
    """Report on every external tool the pipeline depends on."""
    mark = {'ok': 'ok  ', 'warn': 'WARN', 'fail': 'MISS'}
    problems, warnings = [], []
    print('pdf-repack doctor\n')
    print('external programs')

    for name, need, purpose, flags, install in BINARIES:
        path = which(name)
        if path:
            print(f'  {mark["ok"]}  {name:<13} {(_version_of(name, flags) or "?"):<10} {purpose}')
        else:
            state = 'fail' if need == 'required' else 'warn'
            print(f'  {mark[state]}  {name:<13} {"-":<10} {purpose}')
            print(f'        needed for: {need};  install: {install}')
            (problems if need == 'required' else warnings).append(name)

    print('\npython packages (installed automatically by uv)')
    for name, need, purpose in MODULES:
        try:
            mod = __import__(name)
            version = getattr(mod, '__version__', None)
            if version is None:
                try:
                    from importlib.metadata import version as _pkg_version
                    dist = {'PIL': 'pillow', 'skimage': 'scikit-image',
                            'internetarchivepdf': 'archive-pdf-tools'}.get(name, name)
                    version = _pkg_version(dist)
                except Exception:
                    version = '?'
        except ImportError:
            print(f'  {mark["fail"]}  {name:<21} {"-":<10} {purpose}')
            problems.append(name)
            continue
        print(f'  {mark["ok"]}  {name:<21} {str(version):<10} {purpose}')

    print('\nocrmypdf toolchain (pip cannot supply these)')
    for name, need, purpose, install in OCRMYPDF_BINARIES:
        if which(name):
            print(f'  {mark["ok"]}  {name:<13} {(_version_of(name, ["--version"]) or "?"):<10} {purpose}')
        else:
            print(f'  {mark["warn"]}  {name:<13} {"-":<10} {purpose}')
            print(f'        {need};  install: {install}')
            warnings.append(name)

    interpreter = _ocrmypdf_python()
    if interpreter is None:
        print(f'  {mark["warn"]}  cannot locate ocrmypdf\'s interpreter; '
              f'skipping its python dependency checks')
    else:
        for name, need, purpose, install in OCRMYPDF_MODULES:
            dist = {'fpdf': 'fpdf2'}.get(name, name)
            probe = run([interpreter, '-c',
                         f'import {name};'
                         f'v = getattr({name}, "__version__", None);'
                         f'from importlib.metadata import version as V;'
                         f'print(v or V("{dist}"))'],
                        capture_output=True, text=True)
            if probe.returncode == 0:
                print(f'  {mark["ok"]}  {name:<13} '
                      f'{probe.stdout.strip()[:10]:<10} {purpose}')
            else:
                state = 'fail' if need == 'required' else 'warn'
                print(f'  {mark[state]}  {name:<13} {"-":<10} {purpose}')
                print(f'        {need};  install: {install}')
                (problems if need == 'required' else warnings).append(name)

    noto = _has_noto_fonts()
    if noto is False:
        print(f'  {mark["warn"]}  fonts-noto    {"-":<10} ocrmypdf: glyphs for '
              f'non-Latin scripts when highlighting text')
        print('        recommended;  install: apt install fonts-noto')
        warnings.append('fonts-noto')
    elif noto:
        print(f'  {mark["ok"]}  fonts-noto    {"present":<10} ocrmypdf: glyphs for '
              f'non-Latin scripts when highlighting text')

    print('\nchecks')
    # recode_pdf must be reachable as an executable, not just importable
    rp = recode_pdf_bin()
    if which(rp) or Path(rp).exists():
        print(f'  {mark["ok"]}  recode_pdf found at {rp}')
    else:
        print(f'  {mark["fail"]}  recode_pdf not executable; reinstall archive-pdf-tools')
        problems.append('recode_pdf')

    # OCR language data
    if which('tesseract'):
        try:
            langs = run(['tesseract', '--list-langs'],
                                   capture_output=True, text=True, timeout=30)
            available = set(langs.stdout.split()) | set(langs.stderr.split())
            if lang in available:
                print(f'  {mark["ok"]}  tesseract language "{lang}" installed')
            else:
                print(f'  {mark["fail"]}  tesseract language "{lang}" missing;'
                      f' install: apt install tesseract-ocr-{lang}')
                problems.append(f'tesseract-{lang}')
        except (OSError, SubprocessError):
            pass

    # ocrmypdf 17.8.0/17.8.1 crash on pikepdf >= 10 while converting to PDF/A
    ocr_version = _version_of('ocrmypdf', ['--version']) if which('ocrmypdf') else None
    if ocr_version in ('17.8.0', '17.8.1'):
        print(f'  {mark["warn"]}  ocrmypdf {ocr_version} crashes on PDF/A with pikepdf 10 '
              f"(AttributeError: values).\n"
              f"        install: pip install --user 'ocrmypdf==17.7.1'")
        warnings.append('ocrmypdf-version')
    elif ocr_version:
        print(f'  {mark["ok"]}  ocrmypdf {ocr_version} is not a known-broken release')

    # veraPDF must be *detectable by ocrmypdf*, which is stricter than being on
    # PATH: a JVM banner on stdout defeats its version probe.
    # veraPDF must be *detectable by ocrmypdf*, which is stricter than being on
    # PATH. ocrmypdf matches its output against r'veraPDF (\d+(\.\d+)*)', and a
    # JVM banner printed ahead of that defeats the match. ocrmypdf is an
    # external program here, not an import, so replicate the probe directly.
    if which('verapdf'):
        probe = re.compile(r'veraPDF (\d+(\.\d+)*)')

        def probe_ok(env):
            try:
                r = run(['verapdf', '--version'], capture_output=True,
                                   text=True, timeout=60, env=env)
            except (OSError, SubprocessError):
                return False
            return bool(probe.search((r.stdout or '').splitlines()[0] if r.stdout else ''))

        clean = {k: v for k, v in environ.items() if k != '_JAVA_OPTIONS'}
        if probe_ok(clean):
            print(f'  {mark["ok"]}  ocrmypdf can detect veraPDF, so Ghostscript is '
                  f'skipped and JBIG2 survives')
            if not probe_ok(dict(environ)):
                print('        note: _JAVA_OPTIONS in your shell would break this; '
                      'pdf-repack strips it for subprocesses')
        else:
            print(f'  {mark["warn"]}  veraPDF is on PATH but does not report its version '
                  f'in a form ocrmypdf accepts,\n'
                  f'        so Ghostscript will run, convert JBIG2 to CCITT and '
                  f'grow the output ~15%')
            warnings.append('verapdf-probe')
    
    print()
    if problems:
        print(f'{len(problems)} required item(s) missing: {", ".join(problems)}')
    if warnings:
        print(f'{len(warnings)} warning(s): {", ".join(warnings)}\n'
              f'  pdf-repack still runs. See each line above for what is '
              f'affected -- some of these only matter if you invoke ocrmypdf '
              f'yourself.')
    if not problems and not warnings:
        print('all good')
    return 1 if problems else 0


# -------------------------------------------------------------------- driver

METHODS = ('mrc', 'auto', 'bw', 'gray')

METHOD_HELP = """\
mrc    encode every page as MRC: a JBIG2 text mask over a JPEG2000 colour
       background. Keeps text sharp and pictures intact, including colour,
       on the same page. 2-3x smaller than the source. (default)
auto   classify every page and encode each with the codec that suits it.
       Smaller than mrc on text-heavy books, but the classifier cannot tell a
       line-art illustration from a page of text -- both are black strokes on
       white paper -- so it will occasionally binarise a picture and ruin it.
       Use only on books you know are plain text.
bw     encode every page bitonal. Smallest possible, but every photograph and
       halftone is reduced to black and white.
gray   encode every page greyscale. Discards colour entirely.
"""


def parse_args(argv=None):
    p = ArgumentParser(
        prog='pdf-repack',
        description='Repack a scanned PDF at a fraction of its size, '
                    'keeping the text sharp.',
        epilog='Methods:\n' + METHOD_HELP,
        formatter_class=RawDescriptionHelpFormatter)

    p.add_argument('-i', '--input', type=Path, metavar='PATH',
                   help='a PDF; a directory of PDFs, all of which are '
                        'repacked (not recursive); or a directory of page '
                        'images making up one book')
    p.add_argument('-o', '--output', type=Path, metavar='PATH',
                   help='output file, or an existing directory to write into '
                        'when the input is a directory of PDFs '
                        '(default: <input>.<method>.pdf beside the input)')
    p.add_argument('-m', '--method', default='mrc', choices=METHODS,
                   help='encoding strategy (default: mrc)')
    p.add_argument('-f', '--force', action='store_true',
                   help='repack even if the output file already exists; by '
                        'default such inputs are skipped, so an interrupted '
                        'batch can simply be re-run')

    q = p.add_argument_group('quality')
    q.add_argument('-r', '--rate', type=int, default=50, metavar='N',
                   help='JPEG2000 compression ratio for MRC backgrounds. '
                        'LOWER means better quality and bigger files. 50 is a '
                        'good default. If pictures look too soft or lose fine '
                        'detail, step down: 30 costs roughly 40%% more, 20 '
                        'roughly 85%% more (measured across three scanned '
                        'books). Going the other way degrades fast -- 100 was '
                        'judged clearly too poor, and the library default of '
                        '500 destroys photographic detail entirely '
                        '(default: 50)')
    q.add_argument('--bg-downsample', type=int, default=2, metavar='N',
                   help='downsample factor for MRC background layers. Do not '
                        'use 1: it produces files larger than the original '
                        '(default: 2)')
    q.add_argument('--dpi', default='auto', metavar='N|auto',
                   help='resolution for rendering pages and for the output '
                        'page size. "auto" measures the resolution actually '
                        'present in the source, which avoids upsampling a '
                        'low-resolution scan into a larger file (default: auto)')
    q.add_argument('--max-dpi', type=int, default=600, metavar='N',
                   help='upper bound applied when --dpi is auto (default: 600)')

    o = p.add_argument_group('other')
    o.add_argument('-l', '--lang', default='nor', metavar='LANG',
                   help='tesseract language for the text layer (default: nor)')
    o.add_argument('-j', '--jobs', type=int, default=cpu_count() or 4,
                   metavar='N', help='parallel workers (default: all cores)')
    o.add_argument('--jp2-encoder', default='grok',
                   choices=('grok', 'kakadu', 'openjpeg', 'pillow'),
                   help='JPEG2000 encoder for MRC (default: grok)')
    o.add_argument('--no-pdfa', action='store_true',
                   help='skip PDF/A conversion and emit a plain PDF')
    o.add_argument('--keep-temp', action='store_true',
                   help='keep the working directory for inspection')
    o.add_argument('--doctor', action='store_true',
                   help='check that every external tool and library is '
                        'present, report versions, and say how to install '
                        'whatever is missing')
    o.add_argument('-q', '--quiet', action='store_true',
                   help='suppress progress output')
    return p.parse_args(argv)


def default_output(src: Path, method: str, into: Path | None = None) -> Path:
    stem = src.name[:-4] if src.suffix.lower() == '.pdf' else src.name
    return (into or src.parent) / f'{stem}.{method}.pdf'


def is_our_output(path: Path) -> bool:
    """True for files this tool produced, e.g. 'Book, 1998.mrc.pdf'.

    Without this a second run over a directory would repack its own output
    into 'Book, 1998.mrc.mrc.pdf'.
    """
    if path.suffix.lower() != '.pdf':
        return False
    return Path(path.stem).suffix.lstrip('.') in METHODS


def collect_pdfs(directory: Path, method: str) -> list[Path]:
    """PDFs directly inside a directory, excluding our own output files."""
    return sorted(p for p in directory.iterdir()
                  if p.is_file() and p.suffix.lower() == '.pdf'
                  and not is_our_output(p))


def resolve_dpi(setting, src: Path, max_dpi: int, quiet: bool) -> int:
    if setting != 'auto':
        return setting
    if src.is_dir():
        return 300
    dpi = native_dpi(src, 300, max_dpi)
    log(f'source resolution measured at {dpi} dpi', quiet=quiet)
    return dpi


def process(args, src: Path, out_path: Path) -> None:
    """Repack one book. Raises SystemExit or OSError on failure."""
    quiet = args.quiet
    args.dpi = resolve_dpi(args.dpi_setting, src, args.max_dpi, quiet)

    workdir = Path(mkdtemp(prefix='pdf-repack.'))
    try:
        if src.is_dir():
            ocr_pages_list = collect_images(src, workdir)
        else:
            ocr_pages_list = rasterise(src, workdir, args.dpi, args.jobs, quiet)
        scale = 1.0

        ocr_pages(ocr_pages_list, args.lang, args.jobs, quiet)
        enc_pages = downscale(ocr_pages_list, workdir, scale, quiet)

        if args.method == 'auto':
            log('classifying pages ...', quiet=quiet)
            kinds = [classify(p) for p in enc_pages]
        else:
            forced = {'mrc': 'colour', 'bw': 'text', 'gray': 'grey-picture'}
            kinds = [forced[args.method]] * len(enc_pages)

        groups: dict[str, list[tuple[int, Path, Path]]] = {}
        for page_no, (kind, enc, ocr) in enumerate(
                zip(kinds, enc_pages, ocr_pages_list), 1):
            groups.setdefault(kind, []).append((page_no, enc, ocr))
        log('  ' + '  '.join(f'{k}={len(groups.get(k, []))}' for k in CLASSES),
            quiet=quiet)

        parts = {}
        for kind, members in groups.items():
            path = encode_class(kind, members, workdir, args, scale, quiet)
            parts[kind] = (path, [n for n, _e, _o in members])

        merged = workdir / 'merged.pdf'
        if len(parts) == 1:
            copy(next(iter(parts.values()))[0], merged)
        else:
            log('merging pages back into order ...', quiet=quiet)
            merge(parts, len(enc_pages), merged)

        if args.no_pdfa:
            copy(merged, out_path)
        else:
            to_pdfa(merged, out_path, args.lang, args.jobs, quiet)

        check_encodings(out_path, quiet)

        if src.is_file():
            before, after = src.stat().st_size, out_path.stat().st_size
            ratio = f'{before / after:.1f}x smaller' if after else 'n/a'
            log(f'{out_path.name}: {before/1e6:.2f} MB -> {after/1e6:.2f} MB '
                f'({ratio})', quiet=quiet)
        else:
            log(f'{out_path.name}: {out_path.stat().st_size/1e6:.2f} MB',
                quiet=quiet)
    finally:
        if args.keep_temp:
            log(f'working files kept in {workdir}', quiet=quiet)
        else:
            rmtree(workdir, ignore_errors=True)


def main(argv=None) -> int:
    args = parse_args(argv)
    if args.doctor:
        return doctor(args.lang)
    if args.input is None:
        exit('error: -i/--input is required (or use --doctor)')
    if not args.input.exists():
        exit(f'error: input not found: {args.input}')
    if args.bg_downsample < 1:
        exit('error: --bg-downsample must be at least 1')

    if args.dpi == 'auto':
        args.dpi_setting = 'auto'
    else:
        try:
            args.dpi_setting = int(args.dpi)
        except ValueError:
            exit('error: --dpi must be an integer or "auto"')
        if args.dpi_setting < 1:
            exit('error: --dpi must be positive')

    require('tesseract', 'ocrmypdf')

    # A directory holding PDFs is a batch; one holding page images is a single
    # book. Checking for PDFs first keeps both meanings usable.
    batch = args.input.is_dir() and collect_pdfs(args.input, args.method)
    if batch:
        if args.output and not args.output.is_dir():
            exit('error: with a directory of PDFs, -o must be an existing '
                 'directory to write results into')
        jobs = [(src, default_output(src, args.method, args.output))
                for src in batch]
    else:
        jobs = [(args.input, args.output
                 or default_output(args.input, args.method))]

    if any(src.is_file() for src, _ in jobs):
        require('pdftoppm')

    done = skipped = failed = 0
    for src, out_path in jobs:
        if out_path.exists() and not args.force:
            log(f'skip {src.name}: {out_path.name} exists (use --force)',
                quiet=args.quiet)
            skipped += 1
            continue
        if len(jobs) > 1:
            log(f'\n=== {src.name}', quiet=args.quiet)
        try:
            process(args, src, out_path)
            done += 1
        except (SystemExit, OSError, CalledProcessError) as e:
            # One bad book must not abandon the rest of the batch.
            if len(jobs) == 1:
                raise
            log(f'FAILED {src.name}: {e}', quiet=False)
            failed += 1

    if len(jobs) > 1:
        log(f'\n{done} repacked, {skipped} skipped, {failed} failed',
            quiet=args.quiet)
    return 1 if failed else 0


if __name__ == '__main__':
    exit(main())
