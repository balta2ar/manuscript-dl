# ---------------------------------------------------------------- classifier

CHROMA_LIMIT = 40      # per-pixel max-min RGB spread counted as "coloured"
COLOUR_LIMIT = 0.002   # page-wide chromatic fraction promoting a page to colour
BLOCK_LIMIT = 0.05     # chromatic fraction within any one tile, catches small art
BLOCKS = 8             # page is divided into BLOCKS x BLOCKS tiles
MIDTONE_LIMIT = 0.30   # midtone fraction above which a page holds pictures

CLASSES = ('text', 'grey-picture', 'colour')


def classify(path: Path) -> str:
    """Decide how one page should be encoded.

    Deliberately biased towards 'colour'. Misjudging text as colour costs
    bytes; misjudging colour as text destroys information that cannot be
    recovered. So a small but vivid illustration promotes the whole page even
    though its share of the page area is tiny.
    """
    probe = Image.open(path)
    probe.thumbnail((300, 300))

    rgb = np.asarray(probe.convert('RGB'), dtype=np.int16)
    chroma = (rgb.max(axis=2) - rgb.min(axis=2)) > CHROMA_LIMIT
    if chroma.mean() >= COLOUR_LIMIT:
        return 'colour'

    h, w = chroma.shape
    bh, bw = max(1, h // BLOCKS), max(1, w // BLOCKS)
    for y in range(0, h - bh + 1, bh):
        for x in range(0, w - bw + 1, bw):
            if chroma[y:y + bh, x:x + bw].mean() >= BLOCK_LIMIT:
                return 'colour'

    grey = np.asarray(probe.convert('L'))
    midtone = ((grey >= 60) & (grey <= 200)).mean()
    return 'grey-picture' if midtone >= MIDTONE_LIMIT else 'text'


# ------------------------------------------------------------------ helpers

def sh(cmd, **kw):
    """Run a command with _JAVA_OPTIONS removed.

    That variable makes the JVM print a banner ahead of veraPDF's own output,
    which defeats ocrmypdf's version probe. veraPDF then looks unavailable and
    Ghostscript silently takes over the PDF/A conversion -- which cannot write
    JBIG2 and downgrades it to CCITT, costing roughly 15%.
    """
    env = dict(environ)
    env.pop('_JAVA_OPTIONS', None)
    return run(cmd, env=env, check=True,
                          capture_output=True, text=True, **kw)


def require(*programs):
    missing = [p for p in programs if which(p) is None]
    if missing:
        exit(f'error: required program(s) not found on PATH: '
                 f'{", ".join(missing)}')


def recode_pdf_bin() -> str:
    """recode_pdf ships beside this script's interpreter in the uv venv."""
    local = Path(executable).parent / 'recode_pdf'
    return str(local) if local.exists() else 'recode_pdf'


def log(msg, *, quiet=False):
    if not quiet:
        print(msg, file=stderr, flush=True)


def _page_images(page):
    """Yield (name, image) for a page, across pikepdf versions."""
    getter = getattr(page, 'get_images', None)
    if getter is not None:
        try:
            return list(getter().items())
        except Exception:
            pass
    return list(page.images.items())


# --------------------------------------------------------------- page input

def native_dpi(src: Path, fallback: int, cap: int) -> int:
    """Infer the resolution actually present in the source PDF.

    Rendering above this invents pixels: the encoders then spend bytes on
    upsampled detail that was never in the scan, and the output can end up
    several times larger than the input. Rendering below it throws away real
    detail. So measure it rather than guessing.
    """
    best = 0
    with pikepdf.open(src) as pdf:
        for page in pdf.pages:
            box = page.MediaBox
            width_in = (float(box[2]) - float(box[0])) / 72.0
            if width_in <= 0:
                continue
            for _name, image in _page_images(page):
                try:
                    best = max(best, int(int(image.Width) / width_in))
                except (AttributeError, ValueError, ZeroDivisionError):
                    continue
    if not best:
        return fallback
    return max(72, min(best, cap))


def rasterise(src: Path, workdir: Path, dpi: int, jobs: int, quiet: bool) -> list[Path]:
    """Render the input PDF to one PNG per page."""
    imgs = workdir / 'imgs'
    imgs.mkdir(parents=True, exist_ok=True)
    log(f'rendering {src.name} at {dpi} dpi ...', quiet=quiet)
    sh(['pdftoppm', '-r', str(dpi), '-png', str(src), str(imgs / 'page')])
    pages = sorted(imgs.glob('page*.png'))
    if not pages:
        exit('error: no pages rendered from input')
    # normalise to a strict 4-digit sequence, which recode_pdf globs in order
    out = []
    for n, p in enumerate(pages, 1):
        dst = imgs / f'{n:04d}.png'
        if p != dst:
            p.rename(dst)
        out.append(dst)
    return out


def collect_images(srcdir: Path, workdir: Path) -> list[Path]:
    """Use an existing directory of page images."""
    found = sorted(p for p in srcdir.iterdir()
                   if p.suffix.lower() in ('.png', '.jpg', '.jpeg', '.tif', '.tiff'))
    if not found:
        exit(f'error: no page images found in {srcdir}')
    imgs = workdir / 'imgs'
    imgs.mkdir(parents=True, exist_ok=True)
    out = []
    for n, p in enumerate(found, 1):
        dst = imgs / f'{n:04d}.png'
        if p.suffix.lower() == '.png':
            link(p, dst) if p.stat().st_dev == imgs.stat().st_dev else copy(p, dst)
        else:
            Image.open(p).save(dst)
        out.append(dst)
    return out


# ------------------------------------------------------------------- the OCR

HOCR_HEAD = (
    "<?xml version='1.0' encoding='UTF-8'?>\n"
    "<html xmlns='http://www.w3.org/1999/xhtml'><head><title></title>"
    "<meta http-equiv='Content-Type' content='text/html;charset=utf-8'/>"
    "<meta name='ocr-system' content='tesseract'/></head>\n<body>\n"
)


def ocr_pages(pages: list[Path], lang: str, jobs: int, quiet: bool) -> None:
    """One OCR pass for the whole book; every encoder reuses this hOCR."""
    log(f'running OCR on {len(pages)} pages ({lang}) ...', quiet=quiet)

    def one(p: Path):
        sh(['tesseract', str(p), str(p.with_suffix('')), '-l', lang, 'hocr'])

    with ThreadPoolExecutor(max_workers=jobs) as pool:
        list(pool.map(one, pages))


def page_div(hocr: Path, seq: int) -> str:
    text = hocr.read_text(encoding='utf-8')
    m = re.search(r"(<div class='ocr_page'.*?)(?=</body>)", text, re.S)
    if not m:
        return f"<div class='ocr_page' id='page_{seq}'></div>"
    return re.sub(r"id='page_\d+'", f"id='page_{seq}'", m.group(1))


def write_hocr(dest: Path, hocrs: list[Path], scale: float = 1.0) -> None:
    divs = [page_div(h, i) for i, h in enumerate(hocrs, 1)]
    body = HOCR_HEAD + '\n'.join(divs) + '\n</body>\n</html>\n'
    body = propagate_font_size(body)
    if scale != 1.0:
        body = scale_hocr(body, scale)
    dest.write_text(body, encoding='utf-8')


# Line-level classes tesseract emits. It labels lines by layout role, so a
# page may contain no 'ocr_line' at all.
_LINE_CLASSES = 'ocr_line|ocr_caption|ocr_header|ocr_textfloat'
_TOKEN = re.compile(
    r"<span class='(?:" + _LINE_CLASSES + r")'[^>]*title=(?P<lq>[\"'])(?P<ltitle>.*?)(?P=lq)"
    r"|<span class='ocrx_word'[^>]*title=(?P<wq>[\"'])(?P<wtitle>.*?)(?P=wq)",
    re.S)
_X_SIZE = re.compile(r'x_size\s+([\d.]+)')


def propagate_font_size(body: str) -> str:
    """Copy each line's x_size onto its words as x_fsize.

    recode_pdf reads the font size from an ``x_fsize`` attribute on the *word*,
    but tesseract only ever writes ``x_size`` on the *line*. Without this the
    parser sees a font size of zero for every word, the line-height fallback is
    degenerate too, and everything is drawn at the hardcoded 8 pt default. The
    text layer then sits far too small to select, and viewers cannot group
    words into lines, so copied text comes out one word per line in geometric
    rather than reading order.
    """
    current = None

    def sub(m):
        nonlocal current
        if m.group('ltitle') is not None:
            found = _X_SIZE.search(m.group('ltitle'))
            current = found.group(1) if found else None
            return m.group(0)
        if current is None or 'x_fsize' in m.group('wtitle'):
            return m.group(0)
        quote = m.group('wq')
        return m.group(0)[:-len(m.group('wtitle')) - len(quote)] + \
            f"{m.group('wtitle')}; x_fsize {current}{quote}"

    return _TOKEN.sub(sub, body)


_BBOX = re.compile(r'\bbbox (\d+) (\d+) (\d+) (\d+)')
_BASELINE = re.compile(r'\bbaseline ([-\d.]+) ([-\d.]+)')


def scale_hocr(body: str, scale: float) -> str:
    """Rescale hOCR geometry from the OCR raster to the encoding raster.

    OCR wants roughly 300 dpi to read small type; the encoder wants the
    source's native resolution so it does not spend bytes on invented pixels.
    Those are different rasters, so the coordinates have to be moved between
    them or the text layer lands in the wrong place.
    """
    def bbox(m):
        v = [int(round(int(g) * scale)) for g in m.groups()]
        return f'bbox {v[0]} {v[1]} {v[2]} {v[3]}'

    def baseline(m):
        # first value is a slope and must not be scaled; second is an offset
        return f'baseline {m.group(1)} {float(m.group(2)) * scale:.3f}'

    return _BASELINE.sub(baseline, _BBOX.sub(bbox, body))


# -------------------------------------------------------------- the encoders

def mode_flags(kind: str, args) -> list[str]:
    if kind == 'text':
        return ['--bw-pdf']
    if kind == 'grey-picture':
        return ['--grayscale-pdf']
    return ['--mrc-image-format', 'jpeg2000',
            '-J', args.jp2_encoder,
            '--bg-downsample', str(args.bg_downsample),
            f'--bg-compression-flags=-r {args.rate}',
            f'--hq-bg-compression-flags=-r {args.rate}']


def downscale(pages: list[Path], workdir: Path, factor: float,
              quiet: bool) -> list[Path]:
    """Produce the encoding raster from the (higher resolution) OCR raster."""
    if factor >= 1.0:
        return pages
    dest = workdir / 'enc'
    dest.mkdir(parents=True, exist_ok=True)
    log(f'downscaling to encoding resolution ({factor:.2f}x) ...', quiet=quiet)
    out = []
    for p in pages:
        img = Image.open(p)
        size = (max(1, round(img.width * factor)), max(1, round(img.height * factor)))
        target = dest / p.name
        img.resize(size, Image.LANCZOS).save(target)
        out.append(target)
    return out


def encode_class(kind: str, pages: list[tuple[int, Path, Path]], workdir: Path,
                 args, scale: float, quiet: bool) -> Path:
    """Stage one class's images and hOCR, then recode them together."""
    d = workdir / f'cls-{kind}'
    (d / 'imgs').mkdir(parents=True, exist_ok=True)

    hocrs = []
    for seq, (_page_no, enc_img, ocr_img) in enumerate(pages, 1):
        copy(enc_img, d / 'imgs' / f'{seq:04d}.png')
        hocrs.append(ocr_img.with_suffix('.hocr'))
    write_hocr(d / 'all.hocr', hocrs, scale)

    out = workdir / f'{kind}.pdf'
    cmd = [recode_pdf_bin(),
           '-I', str(d / 'imgs' / '*.png'),
           '-T', str(d / 'all.hocr'),
           '-o', str(out),
           '--dpi', str(args.dpi)] + mode_flags(kind, args)
    log(f'  encoding {len(pages):4d} {kind:<13} pages ...', quiet=quiet)
    try:
        sh(cmd)
    except CalledProcessError as e:
        exit(f'error: recode_pdf failed for class {kind}:\n'
                 f'{(e.stderr or e.stdout or "").strip()[-2000:]}')
    return out


def merge(parts: dict[str, tuple[Path, list[int]]], total: int,
          dest: Path) -> None:
    """Interleave the per-class PDFs back into original page order."""
    where = {}
    for kind, (_path, page_numbers) in parts.items():
        for seq, page_no in enumerate(page_numbers):
            where[page_no] = (kind, seq)

    opened = {kind: pikepdf.open(path) for kind, (path, _) in parts.items()}
    out = pikepdf.Pdf.new()
    for page_no in range(1, total + 1):
        kind, seq = where[page_no]
        out.pages.append(opened[kind].pages[seq])
    out.save(dest)
    for pdf in opened.values():
        pdf.close()


# ------------------------------------------------------------------- PDF/A

def to_pdfa(src: Path, dest: Path, lang: str, jobs: int, quiet: bool) -> bool:
    """Wrap as PDF/A without re-encoding any image.

    Relies on ocrmypdf's speculative path, which builds the PDF/A structures
    with pikepdf and validates with veraPDF rather than invoking Ghostscript.
    Ghostscript cannot write JBIG2 and would downgrade it to CCITT.
    """
    # recode_pdf writes its own output intent; ocrmypdf's speculative
    # conversion adds a second with a different destination profile, which
    # veraPDF rejects under PDF/A-2 clause 6.2.3. One failed rule is enough to
    # fall back to Ghostscript, so drop any pre-existing intent first.
    stripped = src.with_name('stripped.pdf')
    with pikepdf.open(src) as pdf:
        if '/OutputIntents' in pdf.Root:
            del pdf.Root['/OutputIntents']
        pdf.save(stripped)

    log('wrapping as PDF/A ...', quiet=quiet)
    try:
        sh(['ocrmypdf', '--skip-text', '--output-type', 'pdfa',
             '--optimize', '0', '-l', lang, '--jobs', str(jobs), '--quiet',
             str(stripped), str(dest)])
        return True
    except CalledProcessError as e:
        log(f'warning: PDF/A conversion failed, keeping plain PDF\n'
            f'{(e.stderr or "").strip()[-500:]}', quiet=quiet)
        copy(stripped, dest)
        return False


def check_encodings(path: Path, quiet: bool) -> None:
    """Warn if the expected codecs did not survive.

    The failure mode is silent: a valid but larger file with degraded images,
    which is what happens when Ghostscript takes over the PDF/A step.
    """
    seen = set()
    with pikepdf.open(path) as pdf:
        for page in pdf.pages:
            for _name, image in _page_images(page):
                seen.add(str(image.get('/Filter')))
    if any('CCITT' in f for f in seen):
        log('warning: output contains CCITTFaxDecode images, which means '
            'Ghostscript re-encoded the JBIG2 layer. Check that veraPDF is on '
            'PATH and reports its version cleanly.', quiet=quiet)
    log(f'  codecs in output: {", ".join(sorted(seen)) or "none"}', quiet=quiet)


