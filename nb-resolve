#!/usr/bin/env python3
"""nb-resolve: stdin filter that resolves bare nb.no book IDs to 'Author - Title, Year'.

Usage (neovim visual selection):
    :'<,'>!./nb-resolve

Lines already containing a title argument are passed through unchanged.
Lines with unresolvable IDs are passed through unchanged (error to stderr).
"""

import re
import sys
from pathlib import Path

# nbno.py is in the same directory as this script
sys.path.insert(0, str(Path(__file__).parent))
import nbno  # noqa: E402

# Matches a pueue line with a bare 32-hex book ID at the end of the inner quoted string.
# A resolved line ends with '...id 'Title'"' so it won't match (ends in '"' not just id+").
# Capture groups: (1) everything up to and including the ID, (2) the 32-hex ID
BARE_ID_RE = re.compile(
    r'^(.*nbno\.py\s+(?:-H\s+\S+\s+)*)([0-9a-f]{32})"$'
)


def resolve_line(line: str) -> str:
    stripped = line.rstrip("\r\n")
    m = BARE_ID_RE.match(stripped)
    if not m:
        return line
    prefix, book_id = m.group(1), m.group(2)
    try:
        filename = nbno.auto_filename(book_id)
    except Exception as e:
        sys.stderr.write(f"nb-resolve: error resolving {book_id}: {e}\n")
        return line
    if not filename:
        sys.stderr.write(f"nb-resolve: could not resolve {book_id}\n")
        return line
    return f"{prefix}{book_id} '{filename}'\"\n"


def main():
    for line in sys.stdin:
        sys.stdout.write(resolve_line(line))


if __name__ == "__main__":
    main()
